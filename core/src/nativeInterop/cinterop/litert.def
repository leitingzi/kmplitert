package = litert
headers = litert/c/litert_common.h litert/c/litert_environment.h litert/c/litert_model.h litert/c/litert_compiled_model.h litert/c/litert_tensor_buffer.h litert/c/litert_options.h litert/c/litert_layout.h litert/c/litert_tensor_buffer_requirements.h
linkerOpts = -lLiteRt

---

static inline int LiteRtGetLayoutRank(const LiteRtLayout* layout) {
  return layout->rank;
}

static inline bool LiteRtGetLayoutHasStrides(const LiteRtLayout* layout) {
  return layout->has_strides;
}